# Send every request that is not a real file or folder (e.g. /backend/products/3) to index.php,
# where FlightPHP matches it to a route. Real files such as public/v1/docs/ are served as they are.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# The config file holds the database password; never serve it, even by mistake.
<FilesMatch "^config\.php$">
    Require all denied
</FilesMatch>
